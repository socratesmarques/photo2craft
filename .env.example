# Docker: interface de rede e portas externas
BIND_ADDRESS=127.0.0.1
WEB_PORT=8081
API_PORT=8000
# API: caminhos relativos são resolvidos a partir do diretório de execução.
# Docker define DATA_DIR internamente. Fora do Docker, vazio/omitido usa photo2craft/data.
# DATA_DIR=/caminho/absoluto/photo2craft/data
# Vazio usa SQLite. PostgreSQL requer driver psycopg e migração; veja docs/architecture.md.
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
MAX_UPLOAD_BYTES=5242880
MAX_REQUEST_BYTES=8388608
MAX_IMAGE_PIXELS=16000000
MAX_BLOCKS=50000
MAX_DIMENSION=64
MAX_PROJECTS=200
# Principal: projeto Google AI Studio Free Tier, SEM faturamento/cartão.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Só marque true depois de conferir o projeto Free Tier no AI Studio.
GEMINI_FREE_TIER_CONFIRMED=false
FALLBACK_PROVIDER=none
GENERATION_MODE=architectural
ENABLE_VISUAL_REFINEMENT=true
MAX_REFINEMENT_PASSES=2
ENABLE_GENERATION_CACHE=true
MAX_REFERENCE_IMAGES=4
# Limite local defensivo, NÃO a cota prometida pelo Google. Cada tentativa conta.
AI_DAILY_CALL_LIMIT=20
AI_MAX_ATTEMPTS=3
AI_TIMEOUT_SECONDS=600
AI_MAX_OUTPUT_TOKENS=16000
# Alternativa local opcional, não necessária para iniciar/executar Gemini.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3-vl:8b
AI_CONTEXT_TOKENS=32768
# Configurações do mod ficam em config/photo2craft.json, não neste arquivo.

# Optional visual artifacts; off by default. Saved under DATA_DIR/debug/<id>.
VISUAL_DEBUG=false
# Offline local Depth-Anything-V2-Small-hf directory. Empty = disabled.
DEPTH_MODEL_PATH=
DEPTH_TIMEOUT_SECONDS=45
# Docker only: opt-in additional CPU dependencies. Requires rebuild.
INSTALL_DEPTH=false
