# Docker: interface de rede e portas externas
BIND_ADDRESS=127.0.0.1
WEB_PORT=8081
API_PORT=8000
# API: caminhos relativos são resolvidos a partir do diretório de execução.
# Docker define DATA_DIR internamente. Fora do Docker, vazio/omitido usa photo2craft/data.
# DATA_DIR=/caminho/absoluto/photo2craft/data
# Vazio usa SQLite. PostgreSQL requer driver psycopg e migração; veja docs/architecture.md.
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
MAX_UPLOAD_BYTES=5242880
MAX_REQUEST_BYTES=8388608
MAX_IMAGE_PIXELS=16000000
MAX_BLOCKS=50000
MAX_DIMENSION=64
MAX_PROJECTS=200
# IA local: Ollama deve estar aberto no Windows e acessível ao Docker.
AI_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e2b
AI_TIMEOUT_SECONDS=600
AI_MAX_OUTPUT_TOKENS=16000
# Usado no detalhado: mais contexto consome mais RAM/VRAM.
AI_CONTEXT_TOKENS=16384
# Configurações do mod ficam em config/photo2craft.json, não neste arquivo.
