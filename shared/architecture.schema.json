{
  "$defs": {
    "Element": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "volume",
            "foundation",
            "wall",
            "floor",
            "roof",
            "tower",
            "column",
            "arch",
            "balcony",
            "stairs",
            "door",
            "window",
            "fence",
            "detail"
          ],
          "title": "Kind",
          "type": "string"
        },
        "shape": {
          "enum": [
            "box",
            "ellipsoid",
            "cylinder",
            "pyramid",
            "gable",
            "line",
            "stairs",
            "arch"
          ],
          "title": "Shape",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/Point"
        },
        "end": {
          "$ref": "#/$defs/Point"
        },
        "axis": {
          "enum": [
            "x",
            "y",
            "z"
          ],
          "title": "Axis",
          "type": "string"
        },
        "hollow": {
          "title": "Hollow",
          "type": "boolean"
        },
        "thickness": {
          "maximum": 4,
          "minimum": 1,
          "title": "Thickness",
          "type": "integer"
        },
        "operation": {
          "enum": [
            "add",
            "cut",
            "paint"
          ],
          "title": "Operation",
          "type": "string"
        },
        "material": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,47}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Material"
        },
        "overlaps": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,47}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Overlaps",
          "type": "array"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "id",
        "kind",
        "shape",
        "start",
        "end",
        "axis",
        "hollow",
        "thickness",
        "operation",
        "material",
        "overlaps",
        "evidence"
      ],
      "title": "Element",
      "type": "object"
    },
